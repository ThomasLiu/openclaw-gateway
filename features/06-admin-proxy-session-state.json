        "ERROR_MESSAGES_MAP：常见错误码到中文描述映射"
      ],
      "passes": true,
      "sourceSpec": "docs/spec/spec-11-session-state-unread-and-caching.md",
      "modificationNote": "中文友好消息，提升用户体验。"
    },
    {
      "id": "test-gateway-history-unit",
      "description": "lib/openclaw/gateway-history.test.ts：网关历史单测",
      "steps": [
        "gatewayHistoryToUiMessages 正确转换 assistant/user/system 消息",
        "处理 tool_use 和 tool_result 消息类型",
        "处理 thinking 消息",
        "处理无 content 情况（空消息）",
        "处理多条连续消息"
      ],
      "passes": true,
      "sourceSpec": "docs/spec/spec-15-testing-and-e2e.md",
      "modificationNote": "在 apps/openclaw-chat/src/ 同级目录创建单测文件。"
    },
    {
      "id": "test-cli-actions-unit",
      "description": "config/openclaw-cli-actions.test.ts：CLI 白名单单测",
      "steps": [
        "isOpenClawCliExecAction 正确识别白名单动作",
        "isOpenClawCliExecAction 拒绝非白名单动作",
        "getOpenClawCliExecArgv 正确构造参数",
        "边界：空 action、undefined action"
      ],
      "passes": true,
      "sourceSpec": "docs/spec/spec-15-testing-and-e2e.md",
      "modificationNote": "安全关键单测，覆盖正向和反向用例。"
    },
